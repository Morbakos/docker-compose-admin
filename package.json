{
	"name": "docker-compose-admin",
	"version": "0.1.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"format": "prettier --config .prettierrc.json src/",
		"format:fix": "prettier --config .prettierrc.json --write src/",
		"tauri": "tauri",
		"lint": "ng lint",
		"format-lint": "bun format:fix && bun lint",
		"test": "bun test tests && ng test --watch=false"
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^22.0.1",
		"@angular/compiler": "^22.0.1",
		"@angular/core": "^22.0.1",
		"@angular/forms": "^22.0.1",
		"@angular/platform-browser": "^22.0.1",
		"@angular/router": "^22.0.1",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"prettier": "^3.10.1",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular-eslint/builder": "22.8.0",
		"@angular/build": "^22.0.1",
		"@angular/cli": "^22.0.1",
		"@angular/compiler-cli": "^22.0.1",
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2",
		"angular-eslint": "22.8.0",
		"eslint": "^10.14.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "8.72.2",
		"jsdom": "^27.2.0",
		"vitest": "^4.0.8"
	}
}

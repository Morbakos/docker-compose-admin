{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"],
    "paths": {
      "@bindings": ["./src/app/bindings.ts"],
      "@components/*": ["./src/app/core/components/*"],
      "@services": ["./src/app/core/services/index"]
    }
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
